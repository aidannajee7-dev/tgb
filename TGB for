local function showPage(page)
    currentPage = page
    clearBody()

    if page == "General" then
        feature("Refresh ESP", "Refresh player outlines when ESP is enabled.", function()
            updateESP()
            notify("ESP refreshed.")
        end)

        feature("Reset Character", "Respawn your character in this experience.", function()
            local hum = getHumanoid()
            if hum then hum.Health = 0 end
        end)

        feature("Selected Player", "Open a list and select another player.", function()
            showPlayerList()
        end)

    elseif page == "Murderer" then
        feature("Murderer Tools", "Role detection must be implemented by the game developer using trusted server role data.", function()
            notify("Connect this to your game's server role system.")
        end)

    elseif page == "Sheriff" then
        feature("Sheriff Tools", "Sheriff status and weapon actions must use your game's server-authorized systems.", function()
            notify("Connect this to your game's sheriff system.")
        end)

    elseif page == "ESP" then
        toggle("Player ESP", "Show outlines around other players in your own experience.", espEnabled, function(value)
            espEnabled = value
            updateESP()
        end)

        feature("Clear ESP", "Remove all player outlines.", function()
            espEnabled = false
            clearESP()
            showPage("ESP")
        end)

    elseif page == "Local Player" then
        toggle("Fast Walk", "ON sets WalkSpeed to 28; OFF restores the default 16.", false, function(value)
            local hum = getHumanoid()
            if hum then hum.WalkSpeed = value and 28 or 16 end
        end)

        toggle("High Jump", "ON raises jump power to 75; OFF restores 50.", false, function(value)
            local hum = getHumanoid()
            if hum then
                hum.UseJumpPower = true
                hum.JumpPower = value and 75 or 50
            end
        end)

        toggle("Fly", "Move with the normal movement controls while flying; jump to rise.", flyEnabled, function(value)
            if value then startFly() else stopFly() end
        end)

        feature("Stop Flying", "Turn off flight and restore normal character movement.", function()
            stopFly()
            showPage("Local Player")
        end)

    elseif page == "Fling Player" then
        feature("Select Player", "Choose a player for your own game's permitted interaction systems.", function()
            showPlayerList()
        end)

        feature("Player Selection Info", "This menu selects a player only. It does not fling or disrupt other players.", function()
            notify(selectedPlayer and ("Selected: " .. selectedPlayer.Name) or "Select a player first.")
        end)

    elseif page == "Aim" then
        feature("Aim Settings", "Aim features are not enabled here. Use fair, server-approved mechanics in your own game.", function()
            notify("No aim automation is attached.")
        end)

    elseif page == "Teleports" then
        feature("Go to Spawn", "Teleport your character to a SpawnLocation in your own experience.", function()
            local root = getRoot()
            local spawnLocation = workspace:FindFirstChildWhichIsA("SpawnLocation", true)

            if root and spawnLocation then
                root.CFrame = spawnLocation.CFrame + Vector3.new(0, 4, 0)
            else
                notify("No SpawnLocation found.")
            end
        end)

    elseif page == "Farm" then
        toggle("Idle Monitor", "Enable or disable a basic character-position monitor.", idleEnabled, function(value)
            if value then startIdleMonitor() else stopIdleMonitor() end
        end)

        feature("Scan Coins", "Count coin-named objects in Workspace; this does not collect them.", function()
            local count = 0
            for _, obj in ipairs(workspace:GetDescendants()) do
                if string.find(string.lower(obj.Name), "coin", 1, true) then
                    count = count + 1
                end
            end
            notify("Found " .. count .. " coin-named objects.")
        end)

    elseif page == "Settings" then
        feature("Refresh Menu", "Rebuild the current page.", function()
            showPage(currentPage)
        end)

        feature("Close Menu", "Hide the menu. Use the reopen button to show it again.", function()
            main.Visible = false
        end)
    end
end

