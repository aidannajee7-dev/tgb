local function label(parent, text, size, position, fontSize)
    local l = Instance.new("TextLabel")
    l.Size = size
    l.Position = position
    l.BackgroundTransparency = 1
    l.Text = text
    l.TextColor3 = MUTED
    l.TextSize = fontSize or 11
    l.Font = Enum.Font.Gotham
    l.TextWrapped = true
    l.TextXAlignment = Enum.TextXAlignment.Left
    l.Parent = parent
    return l
end

local function feature(text, description, callback, parent)
    parent = parent or body

    local card = Instance.new("Frame")
    card.Size = UDim2.new(1, -4, 0, 78)
    card.BackgroundColor3 = Color3.fromRGB(8, 24, 48)
    card.Parent = parent
    corner(card, 8)
    outline(card)

    local b = Instance.new("TextButton")
    b.Size = UDim2.new(1, -12, 0, 34)
    b.Position = UDim2.fromOffset(6, 5)
    b.BackgroundColor3 = Color3.fromRGB(15, 35, 70)
    b.TextColor3 = CYAN
    b.Text = text
    b.TextSize = 11
    b.TextWrapped = true
    b.Font = Enum.Font.GothamBold
    b.Parent = card
    corner(b, 6)

    local desc = label(
        card,
        description,
        UDim2.new(1, -16, 0, 30),
        UDim2.fromOffset(8, 42),
        10
    )
    desc.TextYAlignment = Enum.TextYAlignment.Top

    b.Activated:Connect(function()
        if callback then callback(b) end
    end)

    return b, card
end

local function toggle(text, description, initial, callback)
    local value = initial
    local b

    b = feature(
        text .. ": " .. (value and "ON" or "OFF"),
        description,
        function()
            value = not value
            b.Text = text .. ": " .. (value and "ON" or "OFF")
            b.BackgroundColor3 = value
                and Color3.fromRGB(0, 75, 120)
                or Color3.fromRGB(15, 35, 70)

            if callback then
                callback(value)
            end
        end
    )

    return b
end

local function clearBody()
    for _, child in ipairs(body:GetChildren()) do
        if child:IsA("GuiObject") and child ~= bodyLayout
            and child ~= bodyPadding then
            child:Destroy()
        end
    end
end

local function getHumanoid()
    local character = player.Character
    return character and character:FindFirstChildOfClass("Humanoid")
end

local function getRoot()
    local character = player.Character
    return character and character:FindFirstChild("HumanoidRootPart")
end

local currentPage = "General"
local selectedPlayer = nil
local espEnabled = false
local flyEnabled = false
local idleEnabled = false
local flySpeed = 45
local flyConnection
local flyVelocity
local flyGyro
local idleConnection
local highlights = {}
local savedWalkSpeed = 16
local savedJumpPower = 50

local function clearESP()
    for target, highlight in pairs(highlights) do
        if highlight then highlight:Destroy() end
        highlights[target] = nil
    end
end

local function updateESP()
    clearESP()
    if not espEnabled then return end

    for _, target in ipairs(Players:GetPlayers()) do
        if target ~= player and target.Character then
            local h = Instance.new("Highlight")
            h.Name = "TGBFLICK_ESP"
            h.FillColor = Color3.fromRGB(0, 170, 255)
            h.OutlineColor = CYAN
            h.FillTransparency = 0.55
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.Adornee = target.Character
            h.Parent = gui
            highlights[target] = h
        end
    end
end

local function stopFly()
    flyEnabled = false

    if flyConnection then
        flyConnection:Disconnect()
        flyConnection = nil
    end

    if flyVelocity then
        flyVelocity:Destroy()
        flyVelocity = nil
    end

    if flyGyro then
        flyGyro:Destroy()
        flyGyro = nil
    end

    local hum = getHumanoid()
    if hum then hum.PlatformStand = false end
end

local function startFly()
    local root = getRoot()
    local hum = getHumanoid()

    if not root or not hum then
        notify("Character is not ready.")
        return
    end

    stopFly()
    flyEnabled = true
    hum.PlatformStand = true

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.MaxForce = Vector3.new(1e6, 1e6, 1e6)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("BodyGyro")
    flyGyro.MaxTorque = Vector3.new(1e6, 1e6, 1e6)
    flyGyro.P = 10000
    flyGyro.CFrame = root.CFrame
    flyGyro.Parent = root

    flyConnection = RunService.RenderStepped:Connect(function()
        if not flyEnabled or not root.Parent then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera
        local move = hum.MoveDirection
        local vertical = 0

        if hum.Jump then vertical = vertical + 1 end

        flyVelocity.Velocity =
            (move * flySpeed) + Vector3.new(0, vertical * flySpeed, 0)

        if camera then
            flyGyro.CFrame = camera.CFrame
        end
    end)
end

local function stopIdleMonitor()
    idleEnabled = false
    if idleConnection then
        idleConnection:Disconnect()
        idleConnection = nil
    end
end

local function startIdleMonitor()
    stopIdleMonitor()
    idleEnabled = true

    local lastPosition
    idleConnection = RunService.Heartbeat:Connect(function()
        if not idleEnabled then return end

        local root = getRoot()
        if root then
            lastPosition = root.Position
        end
    end)

    notify("Idle monitor enabled.")
end

